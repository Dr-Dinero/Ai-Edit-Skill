# Fill only the keys needed for your chosen workflow.
# See docs/TOOLS-AND-API-KEYS.md for alternatives and integration requirements.
# Nate's default transcription service; the included helper loads this key.
# Get a key with speech_to_text access at https://elevenlabs.io/app/settings/api-keys
# Copy this file to .env locally. Never commit your key.
ELEVENLABS_API_KEY=

# Only for older examples that actually call ClickUp; use your own API settings.
CLICKUP_API_KEY=
# Alternative Whisper API transcription or optional OpenAI generation.
# Configure the client separately: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Nate's optional provider for generated video and image assets.
# Requires your own credits and model-specific integration: https://docs.kie.ai/
KIE_API_KEY=

# Optional Gemini descriptions in the website-to-video workflow.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional Groq transcription mentioned in the framework reference.
# Configure separately: https://console.groq.com/keys
GROQ_API_KEY=

# Content council media hosting (scripts/publish-media.mjs). Any S3-compatible bucket
# with public reads; Cloudflare R2 by default. Metricool needs a public media URL.
# R2: enable R2, create a bucket, allow public access (r2.dev or a custom domain),
# and create an R2 API token with Object Read & Write on that bucket.
R2_ACCOUNT_ID=
MEDIA_BUCKET=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=
# Set instead of R2_ACCOUNT_ID for another S3-compatible host.
MEDIA_ENDPOINT=
